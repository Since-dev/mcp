{
  "name": "since",
  "version": "1.4.3",
  "description": "Grant, your COO, and his AI team: live answers, team status and decisions, plus World State.",
  "settings": [
    {
      "name": "Since.dev API key",
      "description": "Your Since.dev workspace API key.",
      "envVar": "SINCE_API_KEY",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "since": {
      "httpUrl": "https://api.since.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${SINCE_API_KEY}"
      }
    }
  }
}
